{
  "name": "@sehv-oss/cspell-config",
  "version": "1.1.0",
  "description": "Multi-language (English/Portuguese) CSpell shared configuration for JavaScript/TypeScript projects",
  "type": "module",
  "main": "dist/.cspell.config.js",
  "types": "dist/.cspell.config.d.ts",
  "exports": {
    ".": {
      "types": "./dist/.cspell.config.d.ts",
      "default": "./dist/.cspell.config.js"
    },
    "./pt-br": {
      "types": "./dist/pt-br.cspell.config.d.ts",
      "default": "./dist/pt-br.cspell.config.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint:cspell": "cspell --config .cspell.config.ts .",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cspell",
    "cspell-config",
    "spell-checker",
    "portuguese",
    "pt-br",
    "i18n"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sehv-oss/cspell-config.git"
  },
  "dependencies": {
    "@cspell/dict-pt-br": "2.4.2"
  },
  "peerDependencies": {
    "cspell": ">=10.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664"
}
