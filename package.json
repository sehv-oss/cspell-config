{
  "name": "@sehv-oss/cspell-config",
  "version": "1.0.1",
  "description": "Multi-language (English/Portuguese) CSpell shared configuration for JavaScript/TypeScript projects",
  "type": "module",
  "main": "dist/.cspell.config.js",
  "types": "dist/.cspell.config.d.ts",
  "exports": {
    ".": {
      "types": "./dist/.cspell.config.d.ts",
      "default": "./dist/.cspell.config.js"
    },
    "./pt-br": {
      "types": "./dist/pt-br.cspell.config.d.ts",
      "default": "./dist/pt-br.cspell.config.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint:cspell": "cspell --config .cspell.config.ts .",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cspell",
    "cspell-config",
    "spell-checker",
    "portuguese",
    "pt-br",
    "i18n"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sehv-oss/cspell-config.git"
  },
  "dependencies": {
    "@cspell/dict-pt-br": "2.4.2"
  },
  "peerDependencies": {
    "cspell": ">=10.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22 <27"
  },
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed"
}
